# Copy to .env (root, used by docker-compose) and apps/api/.env (used by Prisma / the API).

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://gatepass:gatepass@localhost:5432/gatepass?schema=public

# Google Workspace OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
JWT_SECRET=change-me
BOOTSTRAP_ADMIN_EMAIL=piyush.kere@coditas.com

# Photo storage (MinIO locally, S3 in AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=gatepass-photos
S3_ACCESS_KEY=gatepass
S3_SECRET_KEY=gatepass-secret

# Email (MailHog locally, SES SMTP in AWS)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Coditas Gate Pass <gatepass@coditas.com>"
