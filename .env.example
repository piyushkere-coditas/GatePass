# Copy to apps/api/.env (used by Prisma and the API).

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://gatepass:gatepass@localhost:5432/gatepass?schema=public

# Auth: email one-time codes + JWT sessions (Phase 1)
JWT_SECRET=change-me
OTP_SECRET=change-me-too
BOOTSTRAP_ADMIN_EMAIL=piyush.kere@coditas.com

# Photo storage (S3 in AWS; local S3-compatible emulator is chosen in Phase 3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=gatepass-photos
S3_ACCESS_KEY=gatepass
S3_SECRET_KEY=gatepass-secret

# Email (MailHog locally, SES SMTP in AWS)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Coditas Gate Pass <gatepass@coditas.com>"
# Only for authenticated SMTP (AWS SES); leave empty for MailHog
SMTP_USER=
SMTP_PASS=
