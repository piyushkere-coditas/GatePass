{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    // Type-check against shared sources, matching the Vite alias, so no shared build is needed first.
    "paths": { "@gatepass/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
